# Copy to a private .env on the NAS; never commit it or share compose config output.
ASSISTANT_HOST_MATERIALS=./materials
EXTERNAL_SERVICES_CONFIG=./config/external-services.local.yml
ASSISTANT_UID=0
ASSISTANT_GID=0
ADMIN_BIND_ADDRESS=127.0.0.1
ADMIN_PORT=8680
ADMIN_COOKIE_SECURE=false
# Trusted per-turn time context; changes require restart. Independent of the host TZ.
CONVERSATION_TIME_ZONE=Asia/Shanghai
ADMIN_INIT_USERNAME=admin
# Supply a unique 12–72 UTF-8 byte password for first startup, then remove it.
ADMIN_INIT_PASSWORD=
