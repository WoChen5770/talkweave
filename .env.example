# Copy to a private .env on the NAS; never commit it or share compose config output.
ASSISTANT_HOST_DATA=./data-multi-user
ASSISTANT_UID=0
ASSISTANT_GID=0
ADMIN_BIND_ADDRESS=127.0.0.1
ADMIN_PORT=8680
ADMIN_COOKIE_SECURE=false
ADMIN_INIT_USERNAME=admin
# Supply a unique 12–72 UTF-8 byte password for first startup, then remove it.
ADMIN_INIT_PASSWORD=
